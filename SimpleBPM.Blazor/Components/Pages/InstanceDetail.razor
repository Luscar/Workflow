@page "/instances/{Id:long}"
@inject IProcessMonitor Monitor
@inject NavigationManager Navigation

<a href="instances" class="back-link">&larr; Back to instances</a>

@if (_loading)
{
    <div class="loading">Loading...</div>
}
else if (_instance == null)
{
    <div class="card">
        <div class="empty-state">Process instance not found</div>
    </div>
}
else
{
    <div class="page-header">
        <h1>Process #@_instance.Id</h1>
        <p>@_instance.DefinitionName v@_instance.DefinitionVersion</p>
    </div>

    <div class="card">
        <div class="card-header">
            <span class="card-title">Instance Details</span>
            <span class="status-badge status-@_instance.Status">@FormatStatus(_instance.Status)</span>
        </div>

        <div class="detail-grid">
            <div class="detail-item">
                <label>Process ID</label>
                <span>@_instance.Id</span>
            </div>
            <div class="detail-item">
                <label>Aggregate ID</label>
                <span>@(_instance.AggregateId ?? "-")</span>
            </div>
            <div class="detail-item">
                <label>Definition</label>
                <span>@_instance.DefinitionName</span>
            </div>
            <div class="detail-item">
                <label>Version</label>
                <span>@_instance.DefinitionVersion</span>
            </div>
            <div class="detail-item">
                <label>Current Node</label>
                <span>@(_instance.CurrentNodeId ?? "-")</span>
            </div>
            <div class="detail-item">
                <label>Started At</label>
                <span>@_instance.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>
            <div class="detail-item">
                <label>Completed At</label>
                <span>@(_instance.CompletedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_instance.ErrorMessage))
        {
            <div class="timeline-error" style="margin-bottom: 1rem;">
                <strong>Error:</strong> @_instance.ErrorMessage
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header">
            <span class="card-title">Variables</span>
        </div>

        @if (_instance.Variables.Count == 0)
        {
            <div class="empty-state">No variables set</div>
        }
        else
        {
            <table class="variables-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var variable in _instance.Variables.OrderBy(v => v.Key))
                    {
                        <tr>
                            <td><strong>@variable.Key</strong></td>
                            <td>@variable.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <div class="card-header">
            <span class="card-title">Execution History</span>
            <span style="color: var(--color-text-secondary); font-size: 0.85rem;">
                @_history.Count step(s)
            </span>
        </div>

        @if (_history.Count == 0)
        {
            <div class="empty-state">No execution history available</div>
        }
        else
        {
            <div class="timeline">
                @foreach (var entry in _history)
                {
                    <div class="timeline-item">
                        <div class="timeline-dot @(entry.Success ? "success" : "failure")"></div>
                        <div class="timeline-header">
                            <span class="timeline-node-name">@entry.NodeName</span>
                            <span class="node-type-badge">@entry.NodeType</span>
                        </div>
                        <div class="timeline-meta">
                            @entry.StartedAt.ToString("HH:mm:ss.fff") &rarr; @entry.CompletedAt.ToString("HH:mm:ss.fff")
                            &middot; @FormatDuration(entry.Duration)
                            @if (!string.IsNullOrEmpty(entry.NextNodeId))
                            {
                                <span>&middot; Next: @entry.NextNodeId</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(entry.ErrorMessage))
                        {
                            <div class="timeline-error">@entry.ErrorMessage</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public long Id { get; set; }

    private bool _loading = true;
    private Processus? _instance;
    private List<NodeExecutionHistory> _history = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _instance = await Monitor.GetInstanceAsync(Id);
            _history = await Monitor.GetExecutionHistoryAsync(Id);
        }
        catch (InvalidOperationException)
        {
            _instance = null;
        }

        _loading = false;
    }

    private static string FormatStatus(ProcessStatus status) => status switch
    {
        ProcessStatus.Running => "Running",
        ProcessStatus.WaitingInteraction => "Waiting Interaction",
        ProcessStatus.WaitingDate => "Waiting Date",
        ProcessStatus.WaitingSignal => "Waiting Signal",
        ProcessStatus.Completed => "Completed",
        ProcessStatus.Failed => "Failed",
        _ => status.ToString()
    };

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalMilliseconds < 1000)
            return $"{duration.TotalMilliseconds:F0}ms";
        if (duration.TotalSeconds < 60)
            return $"{duration.TotalSeconds:F1}s";
        return $"{duration.TotalMinutes:F1}min";
    }
}
