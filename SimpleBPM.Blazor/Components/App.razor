<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="css/app.css" />
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>

<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />
    <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
    <script>
        mermaid.initialize({ startOnLoad: false, theme: 'base', themeVariables: {
            primaryColor: '#dbeafe', primaryBorderColor: '#3b82f6', primaryTextColor: '#1e293b',
            lineColor: '#94a3b8', fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
            fontSize: '13px'
        }});
        var mermaidCounter = 0;
        window.renderMermaid = async function(elementId, definition) {
            var el = document.getElementById(elementId);
            if (!el) return;
            try {
                var id = 'mermaid-svg-' + (mermaidCounter++);
                var result = await mermaid.render(id, definition);
                el.innerHTML = result.svg;
            } catch (e) {
                el.innerHTML = '<p style="color:#ef4444;font-size:0.85rem;">Failed to render graph</p>';
            }
        };
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
